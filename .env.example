# ===========================================
# AI-Scientist-v2 Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Usage: source .env

# -------------------------------------------
# Custom OpenAI-Compatible API (推荐)
# -------------------------------------------
# 适用于任何兼容 OpenAI 协议的 API 供应商
CUSTOM_API_KEY="sk-XXX"
CUSTOM_BASE_URL="https://open.cherryin.ai/v1"
CUSTOM_MODEL="agent/glm-4.6(free)"

# -------------------------------------------
# Custom Vision Language Model (VLM)
# -------------------------------------------
# 视觉模型，用于分析实验生成的图表（需要支持图像输入的模型）
# 如果不设置，将使用 CUSTOM_MODEL 作为默认值
CUSTOM_VLM_MODEL="qwen/qwen3-vl-235b-a22b-instruct(free)"

# -------------------------------------------
# OpenAI API
# -------------------------------------------
# OPENAI_API_KEY="sk-..."

# -------------------------------------------
# Anthropic API (Claude)
# -------------------------------------------
# ANTHROPIC_API_KEY="sk-ant-..."

# -------------------------------------------
# Google Gemini API
# -------------------------------------------
# GEMINI_API_KEY="..."

# -------------------------------------------
# AWS Bedrock (for Claude models)
# -------------------------------------------
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION_NAME="us-east-1"

# -------------------------------------------
# DeepSeek API
# -------------------------------------------
# DEEPSEEK_API_KEY="..."

# -------------------------------------------
# OpenRouter API (for Llama models)
# -------------------------------------------
# OPENROUTER_API_KEY="..."

# -------------------------------------------
# HuggingFace API
# -------------------------------------------
# HUGGINGFACE_API_KEY="..."

# -------------------------------------------
# Semantic Scholar API (可选，用于文献搜索)
# -------------------------------------------
# S2_API_KEY="..."
